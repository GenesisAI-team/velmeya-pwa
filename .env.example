# Ejemplo de variables de entorno de Velmeya PWA.
# VALORES FICTICIOS (placeholder): no usar en producción.
# Copiar a .env.local (`cp .env.example .env.local`) y rellenar con valores locales
# del Emulator Suite. Nunca commitear valores reales (ver .gitignore).

# Configuración web del proyecto Firebase (identificadores públicos del cliente;
# se gestionan por entorno y no se duplican en el código).
VITE_FIREBASE_API_KEY=placeholder-api-key
VITE_FIREBASE_AUTH_DOMAIN=placeholder-auth-domain.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=placeholder-project-id
VITE_FIREBASE_STORAGE_BUCKET=placeholder-storage-bucket.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=placeholder-sender-id
VITE_FIREBASE_APP_ID=placeholder-app-id

# true = el frontend apunta a los emuladores locales (Auth 9099, Firestore 8080, Functions 5001).
# false o ausente = comportamiento de backend real (requiere proyecto y credenciales gestionadas fuera del repo).
VITE_USE_FIREBASE_EMULATORS=true
