// Reglas iniciales de Firestore (GEN-35): denegar todo por defecto.
// No se accede a producción; aflojar por colecciones cuando existan los
// caminos de datos probados del dominio de reservas (ver docs/DATA_MODEL.md).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
